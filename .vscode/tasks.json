{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NEUAURA: Start app and AI",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/desktop.py",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "label": "NEUAURA: Stop app and AI",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/desktop.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "label": "NEUAURA: Run automated tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "scripts/manage.py",
        "test"
      ]
    }
  ]
}
